# ============================================================
# MARIS - Environment Variables Template
# Copy this file to .env and fill in your API keys
# ============================================================

# --- LLM Providers ---
# OpenAI API Key (Optional fallback)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Required for primary and fallback LLM reasoning)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- LangSmith Observability ---
# Sign up free at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=maris-research-agent

# --- Model Configuration ---
# Primary LLM for agent reasoning (cost-effective, fast)
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=llama-3.3-70b-versatile

# Fallback LLM (Groq-based fast model)
FALLBACK_LLM_PROVIDER=groq
FALLBACK_LLM_MODEL=llama-3.1-8b-instant

# Embedding model (using FREE local HuggingFace model — no API costs!)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store ---
QDRANT_PATH=./data/qdrant_db
QDRANT_COLLECTION_NAME=maris_papers

# --- Local Storage ---
SQLITE_DB_PATH=./data/maris.db

# --- ArXiv Settings ---
ARXIV_MAX_RESULTS=10
ARXIV_RATE_LIMIT=3
