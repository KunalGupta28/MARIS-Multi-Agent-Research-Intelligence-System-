# ==============================================================================
# MARIS (Multi-Agent Research Intelligence System) — Environment Configuration
# Copy this file to .env and configure keys to get started.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. LLM API Keys & Provider Settings
# ──────────────────────────────────────────────────────────────────────────────
# At least one provider API key must be set.
# Groq is the primary fast & free provider. OpenAI is the fallback for high-quality structured extraction.

# OpenAI API Configuration (Required if using OpenAI as primary/fallback)
# Create a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Configuration (Highly recommended primary LLM provider)
# Create a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# ──────────────────────────────────────────────────────────────────────────────
# 2. Agent LLM & Embedding Selection
# ──────────────────────────────────────────────────────────────────────────────
# Providers: 'groq' | 'openai'
# Models: Any valid model name from your chosen provider.

# Primary Agent Model (Used for planning, extraction, and synthesis)
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=llama-3.3-70b-versatile

# Fallback Agent Model (Used automatically if primary provider fails/rate-limits)
FALLBACK_LLM_PROVIDER=groq
FALLBACK_LLM_MODEL=llama-3.1-8b-instant

# Embedding Pipeline (Default is 'huggingface' which runs 100% locally on CPU/GPU)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ──────────────────────────────────────────────────────────────────────────────
# 3. LangSmith Observability & Tracing
# ──────────────────────────────────────────────────────────────────────────────
# Track, debug, and monitor agent steps, token usage, and latency waterfalls.
# Sign up at: https://smith.langchain.com/

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=maris-research-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ──────────────────────────────────────────────────────────────────────────────
# 4. Storage & Persistence
# ──────────────────────────────────────────────────────────────────────────────
# Local storage configuration. No Docker or external database servers needed.

# SQLite DB Path for relational metadata, citation networks, and session history
SQLITE_DB_PATH=./data/maris.db

# Qdrant Local Disk Path for vector database embeddings
QDRANT_PATH=./data/qdrant_db
QDRANT_COLLECTION_NAME=maris_papers


# ──────────────────────────────────────────────────────────────────────────────
# 5. ArXiv Ingestion Settings
# ──────────────────────────────────────────────────────────────────────────────
# Control the scale and rate limiting of arXiv searches and downloads.

# Maximum papers to fetch and index per research session
ARXIV_MAX_RESULTS=10

# Delay in seconds between successive API requests to prevent getting throttled
ARXIV_RATE_LIMIT=3
